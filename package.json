{
  "name": "kinneret-algae-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "validate:data": "tsx scripts/validate-algae-data.ts",
    "extract:glossary": "python src/extract_glossary.py",
    "extract:supplements": "python src/extract_supplements.py",
    "extract:about": "python src/extract_about.py",
    "generate:llms": "python scripts/generate_llms_files.py",
    "build:atlas": "npm run validate:data && next build",
    "sync:atlas": "python src/extract_algae.py --output \"data/processed/algae_records.json\" --images-dir public/algae-images --use-word-renderer && npm run extract:supplements && npm run extract:glossary && npm run extract:about && npm run generate:llms && npm run build:atlas"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
